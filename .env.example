# Copy to .env (git-ignored) and point at your own Spyro disc images; set only the titles you own.
# Resolution order everywhere: CLI arg > this env var > .env > a drop-in *.chd in the repo root.
PSXPORT_SPYRO_DISC=/path/to/Spyro the Dragon (USA).chd
PSXPORT_SPYRO2_DISC=/path/to/Spyro 2 - Ripto's Rage! (USA).chd
PSXPORT_SPYRO3_DISC=/path/to/Spyro - Year of the Dragon (USA).chd
