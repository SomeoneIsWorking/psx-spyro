---
Checks: >-
  clang-diagnostic-*,
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  readability-braces-around-statements
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|/)(game|titles|tests)/'
ExcludeHeaderFilterRegex: '(^|/)psxport/'
SystemHeaders: false
CheckOptions:
  readability-braces-around-statements.ShortStatementLines: '0'
FormatStyle: file
...
